    <!-- Estilos adicionales para modo oscuro -->
    <style>
        /* Asegurar contraste óptimo en modo oscuo */
        .dark-input {
            background-color: rgba(255, 255, 255, 0.1);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .dark-input::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }
        
        .dark-input:focus {
            outline: none;
            border-color: rgba(255, 255, 255, 0.4);
            box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.1);
        }
        
        /* Scrollbar personalizado para modo oscuro */
        ::-webkit-scrollbar {
            width: 10px;
        }
        
        ::-webkit-scrollbar-track {
            background: #1a1a1a;
        }
        
        ::-webkit-scrollbar-thumb {
            background: #444;
            border-radius: 5px;
        }
        
        ::-webkit-scrollbar-thumb:hover {
            background: #555;
        }
        
        /* Estilo para dark-card */
        .dark-card {
            background: rgba(30, 30, 30, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1rem;
        }
        
        /* ========== ESTILOS DEL NAVBAR IDÉNTICOS ========== */
        .nav-icon {
            position: relative;
            padding: 0.5rem;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
            color: #9ca3af;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .nav-icon:hover {
            color: white;
            background: rgba(255, 255, 255, 0.05);
            transform: translateY(-2px);
        }
        
        .nav-icon.active {
            background: rgba(99, 102, 241, 0.2);
            color: #818cf8;
        }
        
        .nav-tooltip {
            position: absolute;
            bottom: -2.5rem;
            left: 50%;
            transform: translateX(-50%);
            background: #111827;
            color: white;
            padding: 0.25rem 0.75rem;
            border-radius: 0.375rem;
            font-size: 0.75rem;
            white-space: nowrap;
            opacity: 0;
            visibility: hidden;
            transition: all 0.2s ease;
            z-index: 50;
            border: 1px solid #374151;
        }
        
        .nav-icon:hover .nav-tooltip {
            opacity: 1;
            visibility: visible;
            bottom: -2rem;
        }
        
        /* ========== ESTILOS PARA MENÚ MÓVIL ========== */
        #mobileMenu {
            box-shadow: -5px 0 25px rgba(0, 0, 0, 0.5);
        }
        
        #mobileMenu.active {
            transform: translateX(0);
        }
        
        /* Overlay para fondo cuando el menú está abierto */
        .menu-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(2px);
            z-index: 30;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }
        
        .menu-overlay.active {
            opacity: 1;
            visibility: visible;
        }
        
        /* Animación suave para los enlaces del menú móvil */
        #mobileMenu a {
            transform: translateX(10px);
            opacity: 0;
            transition: all 0.3s ease;
        }
        
        #mobileMenu.active a:nth-child(1) { transition-delay: 0.1s; }
        #mobileMenu.active a:nth-child(2) { transition-delay: 0.15s; }
        #mobileMenu.active a:nth-child(3) { transition-delay: 0.2s; }
        #mobileMenu.active a:nth-child(4) { transition-delay: 0.25s; }
        #mobileMenu.active a:nth-child(5) { transition-delay: 0.3s; }
        
        #mobileMenu.active a {
            transform: translateX(0);
            opacity: 1;
        }
        
        /* Asegurar que el menú móvil no se desborde en pantallas muy pequeñas */
        @media (max-width: 640px) {
            #mobileMenu {
                width: 100%;
            }
        }
        
        /* Imagen de fondo sutil */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background-image: url('assets/merch-background.jpg');
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            z-index: -1;
            opacity: 0.3;
        }
        
        /* ========== ANIMACIONES PARA PRODUCTOS ========== */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .product-card {
            animation: fadeInUp 0.6s ease-out forwards;
            opacity: 0;
        }
        
        /* Animaciones escalonadas para productos */
        .product-card:nth-child(1) { animation-delay: 0.1s; }
        .product-card:nth-child(2) { animation-delay: 0.2s; }
        .product-card:nth-child(3) { animation-delay: 0.3s; }
        .product-card:nth-child(4) { animation-delay: 0.4s; }
        .product-card:nth-child(5) { animation-delay: 0.5s; }
        .product-card:nth-child(6) { animation-delay: 0.6s; }
        
        /* Animación hover para productos */
        .product-card:hover {
            transform: translateY(-10px);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }
        
        /* Animación para botón de añadir al carrito */
        .add-to-cart-btn {
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        
        .add-to-cart-btn::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }
        
        .add-to-cart-btn:hover::after {
            width: 300px;
            height: 300px;
        }
        
        /* Estilos para filtros activos */
        .filter-btn.active {
            background: rgba(99, 102, 241, 0.2);
            color: #818cf8;
            border-color: #6366f1;
        }
        
        /* Badge para productos nuevos */
        .new-badge {
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
        
        /* Estilos para el carrito flotante */
        .cart-sidebar {
            transition: transform 0.3s ease;
            box-shadow: -5px 0 25px rgba(0, 0, 0, 0.5);
        }
        
        .cart-item-remove {
            transition: all 0.3s ease;
        }
        
        .cart-item-remove:hover {
            transform: scale(1.1);
            color: #ef4444;
        }
    </style>
</head>
