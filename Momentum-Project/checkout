    <link rel="icon" type="image/png" sizes="128x128" href="assets/Momentum Records Logo.PNG">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome (para algunos iconos específicos del checkout) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Feather Icons (para navbar y componentes comunes) -->
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
    <script src="https://unpkg.com/feather-icons"></script>
    
    <!-- Estilos adicionales para modo oscuro (igual que otras páginas) -->
    <style>
        /* Asegurar contraste óptimo en modo oscuro */
        .dark-input {
            background-color: rgba(255, 255, 255, 0.1);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .dark-input::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }
        
        .dark-input:focus {
            outline: none;
            border-color: rgba(255, 255, 255, 0.4);
            box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.1);
        }
        
        /* Scrollbar personalizado para modo oscuro (igual que otras páginas) */
        ::-webkit-scrollbar {
            width: 10px;
        }
        
        ::-webkit-scrollbar-track {
            background: #1a1a1a;
        }
        
        ::-webkit-scrollbar-thumb {
            background: #444;
            border-radius: 5px;
        }
        
        ::-webkit-scrollbar-thumb:hover {
            background: #555;
        }
        
        /* Estilo para dark-card */
        .dark-card {
            background: rgba(30, 30, 30, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1rem;
        }
        
        /* ========== ESTILOS DEL NAVBAR IDÉNTICOS A OTRAS PÁGINAS ========== */
        .nav-icon {
            position: relative;
            padding: 0.5rem;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
            color: #9ca3af;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .nav-icon:hover {
            color: white;
            background: rgba(255, 255, 255, 0.05);
            transform: translateY(-2px);
        }
        
        .nav-icon.active {
            background: rgba(99, 102, 241, 0.2);
            color: #818cf8;
        }
        
        .nav-tooltip {
            position: absolute;
            bottom: -2.5rem;
            left: 50%;
            transform: translateX(-50%);
            background: #111827;
            color: white;
            padding: 0.25rem 0.75rem;
            border-radius: 0.375rem;
            font-size: 0.75rem;
            white-space: nowrap;
            opacity: 0;
            visibility: hidden;
            transition: all 0.2s ease;
            z-index: 50;
            border: 1px solid #374151;
        }
        
        .nav-icon:hover .nav-tooltip {
            opacity: 1;
            visibility: visible;
            bottom: -2rem;
        }
        
        /* ========== ESTILOS PARA MENÚ MÓVIL (igual que otras páginas) ========== */
        #mobileMenu {
            box-shadow: -5px 0 25px rgba(0, 0, 0, 0.5);
        }
        
        #mobileMenu.active {
            transform: translateX(0);
        }
        
        /* Overlay para fondo cuando el menú está abierto */
        .menu-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(2px);
            z-index: 30;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }
        
        .menu-overlay.active {
            opacity: 1;
            visibility: visible;
        }
        
        /* Animación suave para los enlaces del menú móvil */
        #mobileMenu a {
            transform: translateX(10px);
            opacity: 0;
            transition: all 0.3s ease;
        }
        
        #mobileMenu.active a:nth-child(1) { transition-delay: 0.1s; }
        #mobileMenu.active a:nth-child(2) { transition-delay: 0.15s; }
        #mobileMenu.active a:nth-child(3) { transition-delay: 0.2s; }
        #mobileMenu.active a:nth-child(4) { transition-delay: 0.25s; }
        #mobileMenu.active a:nth-child(5) { transition-delay: 0.3s; }
        
        #mobileMenu.active a {
            transform: translateX(0);
            opacity: 1;
        }
        
        /* ========== ESTILOS PARA CHECKOUT (mantenidos del original) ========== */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .animate-fadeInUp {
            animation: fadeInUp 0.5s ease-out forwards;
        }
        
        .delay-100 {
            animation-delay: 0.1s;
        }
        
        .delay-200 {
            animation-delay: 0.2s;
        }
        
        .delay-300 {
            animation-delay: 0.3s;
        }
        
        .checkout-step {
            transition: all 0.3s ease;
        }
        
        .checkout-step.active {
            border-color: #8b5cf6;
            background-color: rgba(139, 92, 246, 0.05);
        }
        
        .checkout-step.completed {
            border-color: #10b981;
        }
        
        .payment-method:hover {
            border-color: #8b5cf6;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }
        
        .payment-method.selected {
            border-color: #8b5cf6;
            background-color: rgba(139, 92, 246, 0.1);
        }
        
        .order-summary-item {
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 12px;
            margin-bottom: 12px;
        }
        
        .order-summary-item:last-child {
            border-bottom: none;
        }
        
        .form-input {
            transition: all 0.3s ease;
        }
        
        .form-input:focus {
            border-color: #8b5cf6;
            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.2);
        }
        
        /* Estilos del sidebar del carrito (igual que otras páginas) */
        .cart-sidebar {
            transition: transform 0.3s ease;
            box-shadow: -5px 0 25px rgba(0, 0, 0, 0.5);
        }
        
        .cart-item-remove {
            transition: all 0.3s ease;
        }
        
        .cart-item-remove:hover {
            transform: scale(1.1);
            color: #ef4444;
        }
        
        /* Asegurar que el menú móvil no se desborde en pantallas muy pequeñas */
        @media (max-width: 640px) {
            #mobileMenu {
                width: 100%;
            }
        }
        
        /* Estilos específicos para iconos de métodos de pago (mantenidos del original) */
        .payment-icon {
            width: 2rem;
            height: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 1rem;
            font-size: 1.5rem;
        }
    </style>
</head>
